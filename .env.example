# OpenAI Ads (ChatGPT Ads) Advertiser API keys — Ads Manager (https://ads.openai.com) → Settings → API keys.
# Each key is scoped to ONE ad account (= one legal entity + billing country + currency).

# --- One account: the bare key is enough -------------------------------------
OPENAI_ADS_API_KEY=your-ads-api-key-here

# --- Several accounts (agencies, several brands): ONE NAMED KEY PER ACCOUNT ---
# Name = client/brand slug; pick it with the global flag:  ./run.sh --account acme <command>
# With 2+ accounts configured the CLI REFUSES calls without --account (a write on the
# wrong client account cannot be undone). Prefer named keys only — drop the bare key.
# OPENAI_ADS_API_KEY_ACME=...
# OPENAI_ADS_API_KEY_BRANDX=...

# Optional: which named account bare calls (no --account) should use
# OPENAI_ADS_DEFAULT_ACCOUNT=acme

# Optional, OAuth tokens only (NOT with API keys): OpenAI-Ad-Account header value
# OPENAI_ADS_AD_ACCOUNT=adacct_...
